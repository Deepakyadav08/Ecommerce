body {
  font-family: Arial, sans-serif;
  margin: 0;
  padding: 0;
}

.nav {
  background: #222;
  padding: 12px;
}

.nav a {
  color: white;
  margin-right: 10px;
  text-decoration: none;
}

.container {
  padding: 16px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 12px;
}

.card {
  border: 1px solid #ddd;
  padding: 12px;
  border-radius: 8px;
}

.btn {
  display: inline-block;
  margin-top: 8px;
  padding: 8px 12px;
  background: black;
  color: white;
  text-decoration: none;
  border-radius: 6px;
}

.img {
  width: 100%;
  max-height: 180px;
  object-fit: cover;
  margin-top: 8px;
}

.table {
  width: 100%;
  border-collapse: collapse;
}

.table th, .table td {
  border: 1px solid #ddd;
  padding: 8px;
}

.form input, .form textarea {
  width: 100%;
  padding: 8px;
  margin: 6px 0 12px 0;
}